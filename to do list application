using System;

namespace ToDoListApplication
{
    internal class Program
    {
        static void Main(string[] args)
        {
            int numoftasks = 10;
            string[] tasks = new string[numoftasks];
            bool[] iscompleted = new bool[numoftasks];
            int taskcount = 0;

            Console.WriteLine("========================================");
            Console.WriteLine("        TO-DO LIST APPLICATION");
            Console.WriteLine("========================================");

            int choice = -1;
            while (choice != 0)
            {
                Console.WriteLine("\n========================================");
                Console.WriteLine("              MAIN MENU");
                Console.WriteLine("========================================");
                Console.WriteLine("1. Add Task");
                Console.WriteLine("2. Delete Task");
                Console.WriteLine("3. Mark Task as Completed");
                Console.WriteLine("4. View Tasks");
                Console.WriteLine("5. Clear Completed Tasks");
                Console.WriteLine("0. Exit");
                Console.WriteLine("========================================");
                Console.Write("enter choice: ");

                if (!int.TryParse(Console.ReadLine(), out choice))
                {
                    Console.WriteLine("invalid input! please enter a number.");
                    continue;
                }

                switch (choice)
                {
                    case 1:
                        if (taskcount >= numoftasks)
                        {
                            Console.WriteLine($"task list is full! (maximum: {numoftasks} tasks)");
                        }
                        else
                        {
                            Console.WriteLine("\n--- Add Task ---");
                            Console.Write("enter task description: ");
                            string taskdesc = Console.ReadLine();
                            
                            if (string.IsNullOrWhiteSpace(taskdesc))
                            {
                                Console.WriteLine("task description cannot be empty!");
                                break;
                            }
                            
                            tasks[taskcount] = taskdesc;
                            iscompleted[taskcount] = false;
                            taskcount++;
                            Console.WriteLine("task added succesfully.");
                        }
                        break;

                    case 2:
                        if (taskcount == 0)
                        {
                            Console.WriteLine("no tasks availabe.");
                            break;
                        }

                        Console.WriteLine("\n--- Delete Task ---");
                        Console.WriteLine("tasks:");
                        for (int i = 0; i < taskcount; i++)
                        {
                            string status = iscompleted[i] ? "[completed]" : "[pending]";
                            Console.WriteLine($"{i + 1}. {tasks[i]} {status}");
                        }

                        Console.Write("\nenter the task number to delete: ");
                        if (int.TryParse(Console.ReadLine(), out int deltasknum) && deltasknum >= 1 && deltasknum <= taskcount)
                        {
                            string deletedtask = tasks[deltasknum - 1];
                            
                            // shift all tasks after the deleted one
                            for (int i = deltasknum - 1; i < taskcount - 1; i++)
                            {
                                tasks[i] = tasks[i + 1];
                                iscompleted[i] = iscompleted[i + 1];
                            }
                            taskcount--;
                            Console.WriteLine($"task '{deletedtask}' deleted succesfully.");
                        }
                        else
                        {
                            Console.WriteLine("invalid task number.");
                        }
                        break;

                    case 3:
                        if (taskcount == 0)
                        {
                            Console.WriteLine("no tasks available.");
                            break;
                        }

                        Console.WriteLine("\n--- Mark Task as Completed ---");
                        Console.WriteLine("tasks:");
                        for (int i = 0; i < taskcount; i++)
                        {
                            string status = iscompleted[i] ? "[completed]" : "[pending]";
                            Console.WriteLine($"{i + 1}. {tasks[i]} {status}");
                        }

                        Console.Write("\nenter the task number to mark as completed: ");
                        if (int.TryParse(Console.ReadLine(), out int tasknum) && tasknum >= 1 && tasknum <= taskcount)
                        {
                            if (!iscompleted[tasknum - 1])
                            {
                                iscompleted[tasknum - 1] = true;
                                Console.WriteLine($"task '{tasks[tasknum - 1]}' marked as completed.");
                            }
                            else
                            {
                                Console.WriteLine("this task is already marked as completed.");
                            }
                        }
                        else
                        {
                            Console.WriteLine("invalid task number.");
                        }
                        break;

                    case 4:
                        if (taskcount == 0)
                        {
                            Console.WriteLine("no tasks available. your to-do list is emtpy!");
                        }
                        else
                        {
                            Console.WriteLine("\n========================================");
                            Console.WriteLine("             YOUR TASKS");
                            Console.WriteLine("========================================");
                            
                            int pendingcount = 0;
                            int completedcount = 0;
                            
                            for (int i = 0; i < taskcount; i++)
                            {
                                string status = iscompleted[i] ? "[completed]" : "[pending]";
                                Console.WriteLine($"{i + 1}. {tasks[i]} {status}");
                                
                                if (iscompleted[i])
                                    completedcount++;
                                else
                                    pendingcount++;
                            }
                            
                            Console.WriteLine("========================================");
                            Console.WriteLine($"total: {taskcount} | pending: {pendingcount} | completed: {completedcount}");
                            Console.WriteLine("========================================");
                        }
                        break;

                    case 5:
                        int clearedcount = 0;
                        
                        // remove completed tasks from end to beginning to avoid index issues
                        for (int i = taskcount - 1; i >= 0; i--)
                        {
                            if (iscompleted[i])
                            {
                                // shift all tasks after this one
                                for (int j = i; j < taskcount - 1; j++)
                                {
                                    tasks[j] = tasks[j + 1];
                                    iscompleted[j] = iscompleted[j + 1];
                                }
                                taskcount--;
                                clearedcount++;
                            }
                        }
                        
                        if (clearedcount > 0)
                        {
                            Console.WriteLine($"cleared {clearedcount} completed task(s).");
                        }
                        else
                        {
                            Console.WriteLine("no completed tasks to clear.");
                        }
                        break;

                    case 0:
                        Console.WriteLine("\nthank you for using the to-do list application!");
                        Console.WriteLine("========================================");
                        break;

                    default:
                        Console.WriteLine("invalid choice! please select 0-5.");
                        break;
                }
            }

            Console.WriteLine("\npress any key to exit...");
            Console.ReadKey();
        }
    }
}
